# Copy to .env.local and fill in. Never commit .env.local.
# Supabase Dashboard -> Project Settings -> API Keys.

# Public values (safe in the browser; row-level security protects the data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never put a secret key in a NEXT_PUBLIC_* variable. The web app never
# needs the Supabase secret key: Edge Functions get it from Supabase.

# Cloudinary (previews). NOT web-app variables: they are Supabase Edge
# Function secrets. Keep the values in supabase/functions/.env (git-ignored)
# and push them with:
#   npx supabase secrets set --env-file supabase/functions/.env
# Names (same as RohTre Vault):
#   CLOUDINARY_CLOUD_NAME=
#   CLOUDINARY_API_KEY=
#   CLOUDINARY_API_SECRET=
#   ALLOWED_ORIGINS=http://localhost:3000
